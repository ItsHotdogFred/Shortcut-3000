	(text "Magnetic connectors J1-J12 (4 x 3 module grid, 25.4 mm pitch): 1=GND  2=SCL  3=+3V3  4=SDA  5=INT (open-drain, active low)\nBus 0: GP4 = SDA0, GP5 = SCL0 -> U1 TCA9548A; J1-J6 on U1 channels 0-5; GP8 = INT0 (shared by J1-J6)\nBus 1: GP6 = SDA1, GP7 = SCL1 -> U2 TCA9548A; J7-J12 on U2 channels 0-5; GP9 = INT1 (shared by J7-J12)\nPull-ups to +3V3: R1-R4 4.7k on SDA0/SCL0/SDA1/SCL1, R5-R6 10k on INT, R7-R8 10k on mux RESET\nR9-R20 4.7k on SDA_J1-J12, R21-R32 4.7k on SCL_J1-J12 (TCA9548A channel pull-ups)"
		(exclude_from_sim no)
		(at 266.7 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
